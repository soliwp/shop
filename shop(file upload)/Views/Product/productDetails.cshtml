@model ProductViewModel
@{
    ViewData["title"] = Model.Name;
}
<h1 class="text-center mb-4">
    @ViewData["title"]
</h1>
<div class="text-center row d-flex justify-content-center">
    <div class="col-6">
        @if (!string.IsNullOrEmpty(Model.MainImageURL))
        {
            <img src="~/@Model.MainImageURL" style="width:100%"/>            
        }
        else
        {
            <p>
                عکسی وجود ندارد
            </p>
        }
    </div>
    <div class="row mt-3 d-flex justify-content-center">
            @if (Model.ProductImages.Any())
            {
                @foreach(var image in Model.ProductImages)
                {
                <div class="col-3">
                    <img src="~/@image.ImageURL" style="width:100%" />
                
                </div>
                }
            }
    </div>
    <div class="p-0">
        <dl>
            <dt>نام محصول</dt>
            <dd class="m-0">@Model.Name</dd>            

            <dt>قیمت محصول</dt>
            <dd class="m-0">@Model.Price.ToString("N0")</dd>
            
            <dt>دسته بندی محصول</dt>
            <dd class="m-0">@Model.CategoryName</dd>
        </dl>        
    </div>
</div>